diff --git a/take-care-of-my-fridge-be/src/main/resources/application.yml b/take-care-of-my-fridge-be/src/main/resources/application.yml
index 56dffc3e..1890a14f 100644
--- a/take-care-of-my-fridge-be/src/main/resources/application.yml
+++ b/take-care-of-my-fridge-be/src/main/resources/application.yml
@@ -60,0 +61,38 @@ spring:
+# 메트릭. 앱 포트와 분리한 관리 포트(8081)로 health, prometheus만 연다.
+management:
+  server:
+    port: ${MANAGEMENT_PORT:8081}
+  metrics:
+    distribution:
+      # 요청 시간을 구간별로 내보내 Prometheus에서 p90·p95·p99를 histogram_quantile로 계산한다.
+      percentiles-histogram:
+        http.server.requests: true
+  # 추적(Tempo)은 기본이 꺼짐이다. 켤 때만 TRACING_ENABLED=true, 샘플링은 TRACING_SAMPLING(기본 10%)로 정한다.
+  # 켜 두면 요청마다 CPU·메모리를 더 써서 측정 숫자가 달라지므로 기준선 측정에는 끈다.
+  tracing:
+    enabled: ${TRACING_ENABLED:false}
+    sampling:
+      probability: ${TRACING_SAMPLING:0.1}
+  opentelemetry:
+    tracing:
+      export:
+        otlp:
+          endpoint: ${OTLP_TRACING_ENDPOINT:http://tempo:4318/v1/traces}
+  # 메트릭은 Prometheus가 가져가므로 OTLP로 보내지 않는다(추적 라이브러리가 켜는 기본값을 끔).
+  otlp:
+    metrics:
+      export:
+        enabled: false
+  logging:
+    export:
+      otlp:
+        enabled: false
+  endpoints:
+    web:
+      exposure:
+        include: health,prometheus
+  endpoint:
+    health:
+      show-details: always
+      show-components: always
+
@@ -61,0 +100,5 @@ app:
+  # /actuator/prometheus 를 읽는 계정(HTTP Basic). 비밀번호가 비면 계정을 만들지 않아 아무도 읽지 못한다.
+  # 아래 비밀번호 기본값은 로컬 전용이고, 배포(application-prod.yml)는 기본값 없이 환경변수만 쓴다.
+  actuator:
+    username: ${MANAGEMENT_SCRAPE_USERNAME:prometheus}
+    password: ${MANAGEMENT_SCRAPE_PASSWORD:prometheus-local}
