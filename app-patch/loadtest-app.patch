--- /dev/null
+++ b/take-care-of-my-fridge-be/src/main/resources/application-loadtest.yml
@@ -0,0 +1,37 @@
+# 로컬 부하 테스트 전용 프로필. dev에 합치지 않는다.
+# dev 서버의 prod 프로필(application-prod.yml)과 같은 구조로, Parameter Store 대신 맥의 Docker 데이터 서버
+# (docker-compose.yaml의 mysql, redis, kafka, elasticsearch)에 서비스 이름으로 접속한다.
+# 앱 서버 컨테이너가 compose 네트워크에 붙어서 실행되어야 이 이름들이 풀린다.
+# 비밀 값(OPENAI_API_KEY 등)은 이 파일에 넣지 않고 환경변수로 넘긴다.
+spring:
+  jpa:
+    show-sql: false
+    properties:
+      hibernate:
+        format_sql: false
+
+  datasource:
+    url: jdbc:mysql://${MYSQL_HOST:mysql}:${MYSQL_PORT:3306}/${MYSQL_DATABASE:fridge_db}?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
+    username: ${MYSQL_USER:fridge_user}
+    password: ${MYSQL_PASSWORD:12345678}
+
+  data:
+    redis:
+      host: ${REDIS_HOST:redis}
+      port: ${REDIS_PORT:6379}
+
+  kafka:
+    # 컨테이너끼리는 kafka의 내부 리스너(29092)로 붙는다.
+    bootstrap-servers: ${KAFKA_BOOTSTRAP_SERVERS:kafka:29092}
+
+  elasticsearch:
+    uris: ${ELASTICSEARCH_URL:http://elasticsearch:9200}
+
+# 로그를 파일로 남겨 Alloy가 읽어 Loki로 보낸다(컨테이너의 /logs를 맥의 logs 폴더에 연결).
+logging:
+  file:
+    name: ${LOG_FILE:/logs/app.log}
+
+# 예측 워커. dev와 같은 이름(forecast-worker)으로 compose 네트워크에서 붙는다.
+forecast:
+  worker-url: ${FORECAST_WORKER_URL:http://forecast-worker:8091}
