diff --git a/take-care-of-my-fridge-be/src/main/java/org/example/takecareofmyfridgebe/global/config/ActuatorSecurityConfig.java b/take-care-of-my-fridge-be/src/main/java/org/example/takecareofmyfridgebe/global/config/ActuatorSecurityConfig.java
